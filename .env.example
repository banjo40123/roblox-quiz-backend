# คัดลอกไฟล์นี้เป็น .env สำหรับรันในเครื่อง (.env จะไม่ถูก commit ขึ้น git)
# บน Render ให้ไปตั้งค่าตัวแปรเหล่านี้ที่ Dashboard → Service → Environment

# Connection string จาก MongoDB Atlas (สร้าง Cluster ฟรีที่ https://www.mongodb.com/cloud/atlas)
# รูปแบบ: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ชื่อฐานข้อมูล (ไม่ต้องสร้างล่วงหน้า MongoDB จะสร้างให้อัตโนมัติตอนเขียนข้อมูลครั้งแรก)
MONGODB_DB=gast_quiz

# กุญแจลับสำหรับยืนยันตัวตนตอนเกม Roblox ส่งผลมาที่ /api/submit-result
# ต้องตรงกับค่าที่ตั้งไว้ใน HttpReporter.lua (ตัวแปร API_SECRET) ในเกม
API_SECRET=change-this-secret-now

# พอร์ตที่เซิร์ฟเวอร์รัน (Render จะกำหนดให้เองอัตโนมัติ ไม่ต้องตั้งเอง)
PORT=3000
